# PAGINA NUOVA, riserva di Modal su RunPod: SOLO il metodo nuovo (strada J + w2v-bert CTC, kdkc.py).
# Niente LAM, niente Whisper, niente pipeline vecchia. Immagine: ghcr.io/lembodomenico/karaokecreator:kdkc
FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-dev ffmpeg curl xz-utils ca-certificates clang build-essential \
    && rm -rf /var/lib/apt/lists/* && ln -sf /usr/bin/python3 /usr/bin/python

# BSRoformer.cpp (CUDA 12.9, GLIBC 2.38): le sue librerie solo per lui
ARG BSR=https://github.com/chenmozhijin/BSRoformer.cpp/releases/download/v0.1.0/BSRoformer-linux-cuda-12.9.1.tar.xz
RUN mkdir -p /opt/bsr /opt/modelli/as /opt/modelli/wbert \
    && curl -sL "$BSR" | tar -xJ -C /opt/bsr \
    && CLI="$(find /opt/bsr -name bs_roformer-cli -type f | head -1)" && chmod +x "$CLI" \
    && LIBS="$(find /opt/bsr -name '*.so*' -printf '%h\n' | sort -u | tr '\n' ':')" \
    && printf '#!/bin/sh\nLD_LIBRARY_PATH=%s/usr/local/cuda/lib64:$LD_LIBRARY_PATH exec %s "$@"\n' "$LIBS" "$CLI" \
       > /usr/local/bin/bs_roformer-cli && chmod +x /usr/local/bin/bs_roformer-cli

RUN pip install --ignore-installed "torch==2.8.0" "torchvision==0.23.0" "torchaudio==2.8.0" --index-url https://download.pytorch.org/whl/cu128
RUN pip install --ignore-installed "audio-separator[gpu]" audioread soundfile numpy requests runpod \
        "transformers==4.46.3" huggingface_hub safetensors \
    && pip install --force-reinstall --no-deps "torch==2.8.0" "torchvision==0.23.0" "torchaudio==2.8.0" --index-url https://download.pytorch.org/whl/cu128
RUN CS="$(python -c "import os,audio_separator; print(os.path.dirname(audio_separator.__file__))")/separator/common_separator.py" \
    && sed -i 's/librosa\.get_duration(filename=/librosa.get_duration(path=/g' "$CS"

# Modelli dentro l'immagine: htdemucs_ft, w2v-bert, GGUF FP32 (gli stessi di Modal) dal server KC con sha256
RUN audio-separator --download_model_only -m htdemucs_ft.yaml --model_file_dir /opt/modelli/as && ls /opt/modelli/as
RUN python -c "from huggingface_hub import snapshot_download as s; s('mrfakename/w2v-bert-2.0-music-lyrics-ctc', local_dir='/opt/modelli/wbert')"
ARG KDM=https://karaokecreator.karadom.it/kdkc_m7f3a9
RUN cd /opt/modelli \
    && curl -sfL -o karaoke_aufr33.gguf "$KDM/karaoke_aufr33-FP32.gguf" \
    && curl -sfL -o karaoke_gabox.gguf "$KDM/karaoke_gabox_v2-FP32.gguf" \
    && curl -sfL -o voce_anvuew.gguf "$KDM/voce_anvuew-FP32.gguf" \
    && echo "7a6f0b045f9973cb9c9601332282b27137b9811296f0941f1fe8cb30bae2fe26  karaoke_aufr33.gguf" > s.txt \
    && echo "b3b6d2d1512c732abc0611c021b96dbf63d16dfd6857551d609ee5a40df2d21a  karaoke_gabox.gguf" >> s.txt \
    && echo "0bb8f352d5d3731b387a85451a8db0bd928e3687f643c087bc301dc07fcb94da  voce_anvuew.gguf" >> s.txt \
    && sha256sum -c s.txt && rm s.txt && ls -la /opt/modelli

COPY kdkc.py /app/
# controllo VERO: carica le classi che usa kdkc (il 18-10 torchvision diverso da torch rompeva w2v-bert solo in esecuzione)
RUN python -c "import ast, torch, torchvision, torchaudio.functional, audio_separator.separator, runpod; from transformers import Wav2Vec2BertForCTC, Wav2Vec2BertProcessor; from audio_separator.separator import Separator; print(torch.__version__, torchvision.__version__); ast.parse(open('/app/kdkc.py').read()); print('import OK')"
CMD ["python", "-u", "/app/kdkc.py"]
